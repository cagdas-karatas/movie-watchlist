          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Movie",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));\r",
              "const json = pm.response.json();\r",
              "pm.collectionVariables.set(\"movie_id\", json.id);\r",
              "pm.test(\"has id\", () => pm.expect(json.id).to.be.a('number'));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"The Matrix\",\r\n  \"director\": \"Wachowski\",\r\n  \"year\": 1999,\r\n  \"genre\": \"Sci-Fi\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "movies"
          ]
        }
      },
      "response": []
    },
