          "mode": "raw",
          "raw": "{ \"watched\": true, \"rating\": 9 }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/movies/{{movie_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
