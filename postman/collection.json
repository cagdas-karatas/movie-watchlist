    {
      "name": "Mark as Watched",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"is watched\", () => pm.expect(pm.response.json().watched).to.eql(true));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
